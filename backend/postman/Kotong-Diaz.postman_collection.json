{
  "info": {
    "name": "Kotong - API Diaz",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "cashierEmail", "value": "" },
    { "key": "cashierPassword", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "diazToken", "value": "" },
    { "key": "transactionId", "value": "" }
  ],
  "item": [
    {
      "name": "Login Kasir",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{cashierEmail}}\",\n  \"password\": \"{{cashierPassword}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login Kasir berhasil', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('cashier'); });",
        "if (pm.response.code === 200) pm.collectionVariables.set('diazToken', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "Buat Transaksi Tunai",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{diazToken}}" }
        ],
        "url": "{{baseUrl}}/api/transactions",
        "body": { "mode": "raw", "raw": "{\n  \"paymentMethod\": \"cash\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1 }]\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Transaksi dibuat', () => pm.response.to.have.status(201));",
        "if (pm.response.code === 201) pm.collectionVariables.set('transactionId', pm.response.json().transaction.id);"
      ] } }]
    },
    {
      "name": "Daftar Transaksi Saya",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{diazToken}}" }],
        "url": "{{baseUrl}}/api/transactions"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Daftar transaksi terbaca', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "Detail Transaksi",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{diazToken}}" }],
        "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Detail transaksi terbaca', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "Tolak Jumlah Tidak Valid",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{diazToken}}" }
        ],
        "url": "{{baseUrl}}/api/transactions",
        "body": { "mode": "raw", "raw": "{\n  \"paymentMethod\": \"cash\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 0 }]\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Jumlah nol ditolak', () => pm.response.to.have.status(400));"
      ] } }]
    }
  ]
}
