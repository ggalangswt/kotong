{
  "info": {
    "name": "Kotong - API Galang",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "cashierId", "value": "" }
  ],
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"replace-with-a-strong-password\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"] } }]
    },
    {
      "name": "Buat Kasir",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/cashiers",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Kasir Satu\",\n  \"email\": \"kasir@example.com\",\n  \"password\": \"kasir-password-123\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('cashierId', pm.response.json().cashier.id);"] } }]
    },
    {
      "name": "Daftar Kasir",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/cashiers"
      }
    },
    {
      "name": "Nonaktifkan Kasir",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/cashiers/{{cashierId}}/status",
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"inactive\"\n}" }
      }
    }
  ]
}
