PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kotong
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_NAME=Admin Kotong
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Xendit — secret key dari Dashboard > Settings > API Keys (butuh izin Write untuk QR Codes)
XENDIT_SECRET_KEY=xnd_development_replace_me
# Verification token dari Dashboard > Settings > Webhooks (dipakai untuk memverifikasi webhook QR)
XENDIT_CALLBACK_TOKEN=
